# ===================================================
# FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env or .env.local for development
# ===================================================

# Express Backend Base API URL
VITE_API_BASE_URL=http://localhost:3000/api

# Firebase Authentication & Firestore Credentials
# Get these from Firebase Console > Project Settings > Your apps
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase Storage (My Files module)
# 1. Create a free Supabase project at https://supabase.com
# 2. Go to Storage > Create bucket named: student-files
# 3. Set bucket to Public (for public URL generation)
# 4. Go to Project Settings > API to get the values below
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY= sb_publishable_5RuIKuuvI0WyM0ItG2J4Dg_8uazxiP5