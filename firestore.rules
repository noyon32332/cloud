rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Student files: users may only read/update/delete their own files
    // Metadata is created by the client in the 'studentFiles' collection.
    match /studentFiles/{fileId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Student calendar events: users may only access their own events
    match /student_calendar_events/{eventId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // All other collections require an authenticated user (adjust per collection as needed)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}