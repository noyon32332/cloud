# ===================================================
# BACKEND ENVIRONMENT CONFIGURATION (backend/.env.example)
# Copy this file to backend/.env for production / development
# ===================================================

# Server Port
PORT=3000
NODE_ENV=production

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/studysphere?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here
JWT_REFRESH_EXPIRES_IN=30d

# CORS Allowed Origins (Comma separated for production)
CORS_ORIGIN=https://studysphere-edtech.vercel.app,http://localhost:5173
